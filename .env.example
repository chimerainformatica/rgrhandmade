# Production site URL and name
NEXT_PUBLIC_SITE_URL=https://www.rgrhandmade.it
NEXT_PUBLIC_SITE_NAME=

# Public maintenance switch. When true, public pages are rewritten to /workingprogress
# and robots.txt disallows indexing.
VITRIX_MAINTENANCE=false

# Supabase public client credentials
# Get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for Vitrix backoffice writes and bootstrap tasks.
# Never expose this value in client components or this file on GitHub.
# Get this from Supabase project settings (only visible to authenticated users).
SUPABASE_SERVICE_ROLE_KEY=

# Vitrix superadmin bootstrap credentials.
# Keep these server-side only. Set in Netlify dashboard, never in repo.
VITRIX_SUPERADMIN_EMAIL=
VITRIX_SUPERADMIN_PASSWORD=

# Contact form email delivery via SMTP (/api/contact, nodemailer).
# SMTP_USER must be an authenticated sender on your email provider/domain.
# Never use the visitor email as sender; it is used as reply-to by the route.
# SMTP_SECURE=true only for port 465 (implicit TLS); use false for 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# CONTACT_TO accepts a comma-separated list. CONTACT_FROM defaults to SMTP_USER if empty.
CONTACT_TO=info@rgrhandmade.it
CONTACT_CC=
CONTACT_FROM=

# Contact form protection. Enable Turnstile in production only after configuring
# the site key and secret in the Cloudflare dashboard. The rate limiter uses
# Supabase and stores a salted hash, never the visitor IP in clear text.
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_RATE_LIMIT_SALT=
# Optional comma-separated additional origins, e.g. a Netlify preview domain.
CONTACT_ALLOWED_ORIGINS=

# Dev-only: demo user (not used in production)
DEV_DEMO_EMAIL=demo@vitrix.dev
DEV_DEMO_PASSWORD=
